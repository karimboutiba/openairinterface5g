 openair2/RRC/NR/nr_rrc_proto.h                |   3 +
 openair2/RRC/NR/rrc_gNB.c                     |   4 +-
 openair2/RRC/NR/rrc_gNB_nrdc.c                | 261 +++++++++++++++++-
 4 files changed, 263 insertions(+), 19 deletions(-)

diff --git a/openair2/LAYER2/NR_MAC_gNB/nrdc_mac_rrc_dl_handler.c b/openair2/LAYER2/NR_MAC_gNB/nrdc_mac_rrc_dl_handler.c
