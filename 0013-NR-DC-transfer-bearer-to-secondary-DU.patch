                                             .rsrq = true,                                  /* hardcoded */
                                             .sinr = true                                   /* hardcoded */
                                           },
                                           .maxReportCells = 4,                             /* hardcoded */
-                                          .includeBeamMeasurements = false                 /* hardcoded */
+                                          .reportQuantityRS_Indexes = &(NR_MeasReportQuantity_t){
+                                            .rsrp = true,                                  /* hardcoded */
